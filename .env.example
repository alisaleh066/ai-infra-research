# projectsf — environment variables (copy to .env, never commit .env)
# All data fetching primarily uses connected MCP servers; these are optional
# direct-API fallbacks if you run the fetchers outside the MCP environment.

# SEC EDGAR requires a descriptive User-Agent (name + email) per SEC policy.
SEC_EDGAR_USER_AGENT="projectsf research your.name@email.com"

# Optional direct API keys (fallbacks only — MCP is the primary path)
FMP_API_KEY=
EODHD_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# Trading212 (no MCP connected at build time — leave blank; sample file is used)
TRADING212_API_KEY=
